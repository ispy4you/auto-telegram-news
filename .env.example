APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=change_me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
ADMIN_AUTH_ENABLED=true

# PostgreSQL (рекомендуется для production):
DATABASE_URL=postgresql://user:password@localhost/tgnews
# SQLite (только для локальной разработки без PostgreSQL):
# DATABASE_URL=sqlite:///./data/app.db

# Только для docker-compose: задают логин/пароль/имя базы контейнера db.
# DATABASE_URL выше игнорируется при запуске через docker-compose — он
# подставляется автоматически из этих переменных (см. docker-compose.yml).
# POSTGRES_USER=tgnews
# POSTGRES_PASSWORD=change_me
# POSTGRES_DB=tgnews

# Обязательно только для чтения источников (Telethon user session).
# Получить на https://my.telegram.org, один раз на приложение.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/telegram_session/user.session
SOURCE_PROVIDER=telethon

# Прокси для Telethon (опционально) — см. README, раздел «Прокси».
# TELEGRAM_PROXY_TYPE=socks5
# TELEGRAM_PROXY_HOST=
# TELEGRAM_PROXY_PORT=
# TELEGRAM_PROXY_USERNAME=
# TELEGRAM_PROXY_PASSWORD=
# TELEGRAM_PROXY_SECRET=

# ---------------------------------------------------------------------------
# Всё ниже — только начальные значения по умолчанию. После первого запуска
# удобнее и правильнее менять их прямо в админке (Settings) — там они
# применяются сразу, без перезапуска, и хранятся в БД. Эти переменные нужны
# только чтобы было с чего стартовать (или для headless-деплоя без UI).
# ---------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=

TIMEWEB_AI_GATEWAY_API_KEY=
TIMEWEB_AI_GATEWAY_BASE_URL=
TIMEWEB_AI_GATEWAY_MODEL=
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=1600
AI_TIMEOUT_SECONDS=60

FETCH_INTERVAL_SECONDS=120
DEFAULT_LOOKBACK_LIMIT=50
MAX_MEDIA_MB=50
