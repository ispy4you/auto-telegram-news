APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=change_me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# PostgreSQL (рекомендуется для production):
DATABASE_URL=postgresql://user:password@localhost/tgnews
# SQLite (только для локальной разработки без PostgreSQL):
# DATABASE_URL=sqlite:///./data/app.db

# Только для docker-compose: задают логин/пароль/имя базы контейнера db.
# DATABASE_URL выше игнорируется при запуске через docker-compose — он
# подставляется автоматически из этих переменных (см. docker-compose.yml).
# POSTGRES_USER=tgnews
# POSTGRES_PASSWORD=change_me
# POSTGRES_DB=tgnews

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/telegram_session/user.session
SOURCE_PROVIDER=telethon

TELEGRAM_BOT_TOKEN=

TIMEWEB_AI_GATEWAY_API_KEY=
TIMEWEB_AI_GATEWAY_BASE_URL=
TIMEWEB_AI_GATEWAY_MODEL=
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=1600
AI_TIMEOUT_SECONDS=60

FETCH_INTERVAL_SECONDS=120
DEFAULT_LOOKBACK_LIMIT=50
MAX_MEDIA_MB=50

AUTO_PUBLISH_ENABLED=false
DEFAULT_POST_MODE=manual

ADMIN_AUTH_ENABLED=true
